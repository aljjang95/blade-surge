{
  "name": "blade-surge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node tools/write-version.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "preview": "vite preview --host",
    "deploy": "node tools/deploy-guard.mjs && bun run build && wrangler deploy",
    "metrics": "node tools/metrics.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.170.0",
    "playwright": "^1.62.1",
    "typescript": "5.9.3",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
