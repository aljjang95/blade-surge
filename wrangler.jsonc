{
  // 같은 origin의 동행 API와 정적 게임 자산. 승인된 기간·총량을 설정하기 전에는 생성 비활성.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blade-surge",
  "main": "worker/index.ts",
  "routes": [{ "pattern": "blade.tllhouse.com", "custom_domain": true }],
  "mtls_certificates": [{ "binding": "TOSS_MTLS", "certificate_id": "a9deb444-9316-4529-a76c-2e2c1b71fd8e", "remote": true }],
  "compatibility_date": "2025-06-01",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "DIALOGUE_BUDGET", "class_name": "DialogueBudget" }, { "name": "PARTIES", "class_name": "PartyRoom" }, { "name": "SOCIAL", "class_name": "SocialHub" }] },
  "migrations": [{ "tag": "dialogue-budget-v1", "new_sqlite_classes": ["DialogueBudget"] }, { "tag": "party-dungeons-v1", "new_sqlite_classes": ["PartyRoom"] }, { "tag": "social-hub-v1", "new_sqlite_classes": ["SocialHub"] }],
  "vars": {
    "APP_ORIGIN": "https://blade.tllhouse.com",
    "DIALOGUE_ENABLED": "false",
    "DIALOGUE_APPROVAL_ID": "",
    "DIALOGUE_APPROVAL_ISSUED_AT": "",
    "DIALOGUE_APPROVAL_UNTIL": "",
    "COMMERCE_DATABASE_ID": "88d8e114-6c6d-408a-acca-52ede4e94d28",
    "STORE_BILLING_ENABLED": "false",
    "TOSS_REMOVE_ADS_ACTIVE": "false",
    "TOSS_MTLS_APP_NAME": "blade-surge",
    "TOSS_AD_GROUP_ID": "ait.v2.live.b311470e6321418c",
    "TOSS_AD_GROUP_ENABLED": "true",
    // 커뮤니티: 관리자 playerId(쉼표 구분), 로컬 개발 origin 허용, 구글 OAuth 클라이언트 ID(비면 연동 꺼짐).
    "SOCIAL_ADMIN_IDS": "",
    "SOCIAL_DEV_ORIGINS": "false",
    // MMO 계정(/api/v1): 2026-10-29 그림자(0%)로 개방(docs/ACCOUNT_POLICY.md). SESSION_HMAC 시크릿과 D1 마이그레이션 0001~0005가 먼저 있어야 한다.
    "V1_ENABLED": "true",
    "V1_SERVER_AUTHORITY_PERCENT": "0",
    // BM(/api/v1/iap): 기본 비활성. Play 서비스 계정은 아래 Secrets Store 바인딩 PLAY_SA_JSON(apex-shared-apis의 APEX_CLOUD_PLAY_SA_JSON).
    // RTDN은 Pub/Sub push 구독의 OIDC audience·푸시 서비스 계정 고유 ID(sub)를 코디네이터가 설정한 뒤에만 받는다(docs/BM_DESIGN.md 9장).
    "IAP_ENABLED": "false",
    "IAP_ALLOW_TEST": "false",
    // 웹 테스트 채널을 받을 수 있는 account_id(쉼표 구분). IAP_ALLOW_TEST=true여도 여기에 든 계정만 테스트 결제 intent/지급이 된다. 기본 비어 있음.
    "IAP_TEST_ACCOUNTS": "",
    // 웹 결제(포트원 V2): 기본 꺼짐. 켜는 순서는 docs/BM_DESIGN.md '영웅 해금' 개방 순서(D1 0004 원격 적용 → 실채널 키 → 이 스위치 → 대표님 금액 확인).
    // storeId·channelKey는 비밀이 아니다. PORTONE_CHANNEL_KEY가 비면 intent를 거부한다. 테스트 채널('신기충만 - KG이니시스 테스트')은 IAP_ALLOW_TEST=true일 때만 쓰며 실결제 채널로 쓰지 않는다.
    "WEB_BILLING_ENABLED": "false",
    // 웹 결제수단(쉼표 구분). KAKAOPAY·NAVERPAY·TOSSPAY는 KG이니시스 간편결제 계약 추가 뒤에만 넣는다.
    "WEB_PAY_METHODS": "CARD",
    "PORTONE_STORE_ID": "store-75d3b0fa-c6c8-4e9e-b848-8025e4bb7503",
    "PORTONE_CHANNEL_KEY": "",
    "PORTONE_TEST_CHANNEL_KEY": "channel-key-2ec7c4e8-ee17-4958-a205-4ab05d493677",
    "RTDN_AUDIENCE": "",
    "RTDN_PUSH_SUBJECT": "",
    "GOOGLE_CLIENT_IDS": "898058209232-qr2isup4rafe3fhhgt5e1vvntu267sf3.apps.googleusercontent.com",
    // 리다이렉트 로그인(docs/ACCOUNT_POLICY.md). 비면 그 제공자는 꺼진다. 카카오 Client Secret·ChatGPT 기밀 비밀은 vars가 아니라 Worker secret으로만.
    // KAKAO_REST_KEY: Kakao Developers 앱 등록 후. CHATGPT_CLIENT_ID(oaiapp_…): OpenAI 상업 파트너 승인 후.
    "KAKAO_REST_KEY": "",
    "CHATGPT_CLIENT_ID": ""
  },
  "secrets_store_secrets": [{ "binding": "PLAY_SA_JSON", "store_id": "3d9b8481f988422895d49b3460b76b5e", "secret_name": "APEX_CLOUD_PLAY_SA_JSON" },
    { "binding": "PORTONE_API_SECRET", "store_id": "3d9b8481f988422895d49b3460b76b5e", "secret_name": "APEX_CLOUD_PORTONE_API_SECRET" }],
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [{ "binding": "COMMERCE_DB", "database_name": "blade-surge-commerce-production", "database_id": "88d8e114-6c6d-408a-acca-52ede4e94d28", "migrations_dir": "worker/v1/migrations" }],
  // 서버 규칙이 공유하는 클라이언트 모듈 그래프의 CSS import는 Worker에서 쓰지 않는 문자열로 둔다.
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }]
}
