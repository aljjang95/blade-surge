{
  "schema": "blade-surge.asset-split.v1",
  "note": "스토어 네이티브 채널(googleplay·onestore)의 APK 크기를 줄이기 위한 core/remote 분할표. core 는 APK 에 싣고, remote 는 APK 에서 빼고 정식 호스트(host)에서 받아 Cache Storage 에 보관한다. 규칙은 위에서부터 첫 일치가 이긴다(glob: * 는 / 를 넘지 않고 ** 는 넘는다). 어느 규칙에도 안 걸린 산출물 파일이 있으면 빌드와 test/asset-split.test.ts 가 실패한다. 새 콘텐츠(지역 곡·마을 스킨·일러스트)는 아래 remote 규칙에 한 줄 추가하거나, 기본이 remote 인 폴더(bgm/, video/)에 두면 자동으로 remote 가 된다. group 은 사전 내려받기 단위다(region-N = 캠페인 N지역).",
  "host": "https://blade.tllhouse.com",
  "channels": ["googleplay", "onestore"],
  "rules": [
    { "class": "remote", "group": "region-2", "glob": "bgm/regions/forge.*", "reason": "2지역(불씨 용광로) 곡" },
    { "class": "remote", "group": "region-3", "glob": "bgm/regions/frost.*", "reason": "3지역(서리 서고) 곡" },
    { "class": "remote", "group": "region-4", "glob": "bgm/regions/tide.*", "reason": "4지역(별이 잠긴 심해) 곡" },
    { "class": "remote", "group": "region-5", "glob": "bgm/regions/crown.*", "reason": "5지역(새벽을 먹는 왕관) 곡" },
    { "class": "remote", "group": "region-6", "glob": "bgm/regions/homecoming.*", "reason": "6지역(귀환로) 곡" },
    { "class": "remote", "group": "arena", "glob": "bgm/regions/arena.*", "reason": "아레나 곡" },
    { "class": "core", "glob": "bgm/regions/lobby.*", "reason": "1지역 마을 곡(로비)" },
    { "class": "core", "glob": "bgm/regions/garden.*", "reason": "1지역 전투 곡" },
    { "class": "remote", "group": "early-music", "glob": "bgm/regions/boss.*", "reason": "1지역 보스·수문장 곡(1-3부터). 첫 로비에서 곧바로 받아 둔다(remote-prefetch EARLY_GROUP)" },
    { "class": "remote", "group": "early-music", "glob": "bgm/expansion/**", "reason": "중간 보스 곡(1-5). 첫 로비에서 곧바로 받아 둔다" },
    { "class": "remote", "group": "bgm-extra", "glob": "bgm/**", "reason": "위에 없는 새 BGM 은 기본이 remote(콘텐츠가 늘어도 APK 가 커지지 않는다)" },

    { "class": "core", "glob": "img/encounters/garden_*.webp", "reason": "1지역 조우 일러스트" },
    { "class": "core", "glob": "img/encounters/boss_warlord.webp", "reason": "공용 보스 초상(전투 HUD 기본값)" },
    { "class": "remote", "group": "region-2", "glob": "img/encounters/forge_*.webp", "reason": "2지역 조우 일러스트" },
    { "class": "remote", "group": "region-3", "glob": "img/encounters/frost_*.webp", "reason": "3지역 조우 일러스트" },
    { "class": "remote", "group": "region-4", "glob": "img/encounters/tide_*.webp", "reason": "4지역 조우 일러스트" },
    { "class": "remote", "group": "region-5", "glob": "img/encounters/crown_*.webp", "reason": "5지역 조우 일러스트" },
    { "class": "remote", "group": "region-6", "glob": "img/encounters/homecoming_*.webp", "reason": "6지역 조우 일러스트" },
    { "class": "remote", "group": "arena", "glob": "img/encounters/arena_*.webp", "reason": "아레나 상대 초상" },
    { "class": "core", "glob": "img/encounters/{boss_*,chronicle_*}.webp", "reason": "원정 던전 보스 일러스트: 로비 던전 카드 목록이 부팅 직후 모두 그린다(첫 화면)" },
    { "class": "remote", "group": "expeditions", "glob": "img/encounters/mob_*.webp", "reason": "원정 던전 몬스터 일러스트(던전 안에서만 보인다)" },

    { "class": "core", "glob": "img/ui-crafted/keyart/dungeon-garden-keyart.webp", "reason": "1지역 던전 키아트" },
    { "class": "remote", "group": "region-2", "glob": "img/ui-crafted/keyart/dungeon-forge-keyart.webp", "reason": "2지역 던전 키아트" },
    { "class": "remote", "group": "region-3", "glob": "img/ui-crafted/keyart/dungeon-frost-keyart.webp", "reason": "3지역 던전 키아트" },
    { "class": "remote", "group": "region-4", "glob": "img/ui-crafted/keyart/dungeon-tide-keyart.webp", "reason": "4지역 던전 키아트" },
    { "class": "remote", "group": "region-5", "glob": "img/ui-crafted/keyart/dungeon-crown-keyart.webp", "reason": "5지역 던전 키아트" },
    { "class": "remote", "group": "region-6", "glob": "img/ui-crafted/keyart/dungeon-homecoming-keyart.webp", "reason": "6지역 던전 키아트" },
    { "class": "remote", "group": "arena", "glob": "img/expansion/arena.webp", "reason": "아레나 일러스트" },
    { "class": "core", "glob": "img/expansion/glass_garden.webp", "reason": "첫 원정(유리 정원) 키아트·영상 포스터" },
    { "class": "core", "glob": "img/expansion/guild_map.webp", "reason": "CSS 배경(dungeon-journey.css)과 여정 배너" },
    { "class": "core", "glob": "img/expansion/{guardian,ranger,aegis,hp_tonic,overdrive}.webp", "reason": "직업 문장·소모품 아이콘" },
    { "class": "core", "glob": "img/expansion/thumb/**", "reason": "원정 카드 목록용 축소본(목록은 항상 즉시 보인다)" },
    { "class": "core", "glob": "img/expansion/manifest.json", "reason": "원정 이미지 목록" },
    { "class": "remote", "group": "expeditions", "glob": "img/expansion/*.webp", "reason": "원정 던전 상세 키아트(전체 해상도)" },

    { "class": "remote", "group": "cinematic", "glob": "video/**", "reason": "원정 입장 영상" },

    { "class": "remote", "group": "heroes-t2", "glob": "assets/hero_*_t2-*.glb", "reason": "영웅 2단계 갑옷 몸체(번들 해시 이름)" },
    { "class": "remote", "group": "heroes-t3", "glob": "assets/hero_*_t3-*.glb", "reason": "영웅 3단계 갑옷 몸체(번들 해시 이름)" },
    { "class": "remote", "group": "heroes-t2", "glob": "assets/hero_*_{t1s,t2u}-*.glb", "reason": "영웅 S등급(1.5)·U등급 테마(2.5) 몸체(번들 해시 이름)" },
    { "class": "remote", "group": "avatars", "glob": "assets/avatar_*-*.glb", "reason": "아바타 몸체(번들 해시 이름)" },
    { "class": "remote", "group": "heroes-t2", "glob": "models/heroes-next/{ranger-t2-body-fit-v2,rogue-t2-body-fit-v1}.glb", "reason": "궁수·도적 2단계 몸체(궁수 v1 은 이력 전용이라 산출물에서 뺀다, dist-excludes)" },
    { "class": "remote", "group": "heroes-t3", "glob": "models/heroes-next/{ranger-t3-body-fit-v2,rogue-t3-body-fit-v1}.glb", "reason": "궁수·도적 3단계 몸체(궁수 v1 은 이력 전용이라 산출물에서 뺀다, dist-excludes)" },
    { "class": "remote", "group": "heroes-t2", "glob": "models/heroes-next/{rogue,ranger}-{t1s,t2u}-body-fit-v1.glb", "reason": "도적·궁수 S등급(1.5)·U등급 테마(2.5) 몸체(t4-body-revisions)" },
    { "class": "remote", "group": "avatars", "glob": "models/heroes-next/{ranger-fox,rogue-crow,rogue-vampire,ranger-blackcat}-body-fit-v{1,2}.glb", "reason": "여우·까마귀·흡혈 백작·검은 고양이 아바타 몸체(할로윈 t5 는 t5-avatar-body-revisions). 여우·흡혈 백작 v2(2026-10-29 가중치 교정)도 같은 원격 묶음이다(core 로 떨어지면 AAB 여유를 넘는다)" },

    { "class": "remote", "group": "starter-village", "glob": "models/starter-village-v1/*.glb", "reason": "초보자 마을 Tripo 소품 8종(약 4.1MB). AAB 60MB 여유 0.49MB 라 core 금지. 로비 진입 때 바로 받고(EARLY), 못 받으면 절차 모델 폴백" },

    { "class": "remote", "group": "weapons", "glob": "models/item-weapons/**", "reason": "장비 무기 Tripo GLB 102개(약 41.6MB, AAB 압축 후 약 37MB). 선택 사항 외형이라 부팅·1지역 플레이에 필요 없고, 없으면 절차적 무기로 폴백한다(item-weapon-glb). 와이파이 한가할 때 받고, 아이템이 화면에 나올 때 그 아이템 것만 먼저 받는다" },

    { "class": "remote", "group": "item-icons", "glob": "img/item-renders/**", "reason": "장비 렌더 아이콘 77개(약 2.8MB, 영웅 문맥 무기 형태 포함). 이미지는 화면을 막지 않고 호스트·보관본에서 그려진다. 첫 로비에서 곧바로 받아 둔다(remote-prefetch EARLY_GROUPS)" },
    { "class": "remote", "group": "ui-art", "glob": "img/ui-crafted/engraving/**", "reason": "각인(엔그레이빙) 일러스트(약 2.4MB). 각인 화면에서만 보인다" },
    { "class": "remote", "group": "ui-art", "glob": "img/tll/avatars/**", "reason": "아바타 상점 초상(약 0.7MB). 상점에서만 보인다" },

    { "class": "core", "glob": "news/**", "reason": "소식 웹 읽기 페이지(/news, tools/build-news.mjs 산출물). 글 몇 편 분량의 정적 HTML 이라 크기가 작아 core 로 둔다(remote 로 두면 _headers CORS 규칙이 필요)" },

    { "class": "core", "glob": "assets/**", "reason": "스크립트·스타일·몬스터 모델·1단계 영웅(번들 해시 이름)" },
    { "class": "core", "glob": "models/**", "reason": "영웅 1단계·로비·성채·무기·환경 모델" },
    { "class": "core", "glob": "img/**", "reason": "UI·아이콘·초상·장비·재질" },
    { "class": "core", "glob": "sfx/**", "reason": "효과음·음성" },
    { "class": "core", "glob": "textures/**", "reason": "표면 재질" },
    { "class": "core", "glob": "fonts/**", "reason": "글꼴" },
    { "class": "core", "glob": "*", "reason": "루트 문서(index.html, 매니페스트, 정책 문서, 버전, 최적화 기록)" }
  ]
}
