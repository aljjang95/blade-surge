{
  "name": "blade-surge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "node tools/build-news.mjs && vite --host",
    "gen:odds": "node tools/gen-odds-page.mjs",
    "gen:game-info": "node tools/gen-game-info-page.mjs",
    "build": "vite build && node tools/write-version.mjs",
    "news": "node tools/build-news.mjs",
    "news:draft": "node tools/patch-notes.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000",
    "check": "bun run typecheck && bun run test && bun run build && bun run smoke",
    "smoke": "node tools/sortie-smoke.mjs",
    "preview": "vite preview --host",
    "studio": "node tools/studio-server.mjs",
    "qa:mobile": "node tools/mobile-qa.mjs",
    "qa:inapp": "node tools/qa/inapp-touch.mjs",
    "build:aab:cloud": "bash tools/build-aab-cloud.sh",
    "deploy": "node tools/deploy.mjs",
    "pc:bridge": "node tools/pc-bridge.mjs",
    "metrics": "node tools/metrics.mjs",
    "sim:90d": "bun tools/sim-90d.mjs --assert",
    "assets:ingest": "node tools/asset-library/ingest.mjs",
    "assets:verify": "node tools/asset-library/verify.mjs"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.8.0",
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@react-three/fiber": "9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@apps-in-toss/cli": "3.8.0",
    "@capacitor/cli": "8.5.1",
    "@types/bun": "^1.4.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.170.0",
    "meshoptimizer": "0.18.1",
    "playwright": "^1.62.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1",
    "uuid": "11.1.1"
  }
}
