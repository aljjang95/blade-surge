{
  // 같은 origin의 동행 API와 정적 게임 자산. 승인된 기간·총량을 설정하기 전에는 생성 비활성.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blade-surge",
  "main": "worker/index.ts",
  "routes": [{ "pattern": "blade.tllhouse.com", "custom_domain": true }],
  "compatibility_date": "2025-06-01",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "DIALOGUE_BUDGET", "class_name": "DialogueBudget" }, { "name": "PARTIES", "class_name": "PartyRoom" }] },
  "migrations": [{ "tag": "dialogue-budget-v1", "new_sqlite_classes": ["DialogueBudget"] }, { "tag": "party-dungeons-v1", "new_sqlite_classes": ["PartyRoom"] }],
  "vars": {
    "APP_ORIGIN": "https://blade.tllhouse.com",
    "DIALOGUE_ENABLED": "false",
    "DIALOGUE_APPROVAL_ID": "",
    "DIALOGUE_APPROVAL_ISSUED_AT": "",
    "DIALOGUE_APPROVAL_UNTIL": "",
    "COMMERCE_DATABASE_ID": "88d8e114-6c6d-408a-acca-52ede4e94d28",
    "STORE_BILLING_ENABLED": "false",
    "TOSS_REMOVE_ADS_ACTIVE": "false",
    "TOSS_AD_GROUP_ID": "ait.v2.live.b311470e6321418c",
    "TOSS_AD_GROUP_ENABLED": "true"
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [{ "binding": "COMMERCE_DB", "database_name": "blade-surge-commerce-production", "database_id": "88d8e114-6c6d-408a-acca-52ede4e94d28" }]
}
